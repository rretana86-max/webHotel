@model WebHotel_vesion1._0.Models.ViewModel.UsuarioViewModel;

@using WebHotel_vesion1._0.Enums

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center" style="margin-top:2rem">
        <div class="col-12 col-md-6">
            <div class="card shadow-lg border-0">
                <h4 class="card-header text-center bg-success text-white">Registro de Usuarios</h4>
                <div class="card-body">
                    <form asp-controller="Usuarios" asp-action="Create" method="post" id="form-usuario" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-2">
                            <label asp-for="IdUsuario" class="form-label"></label>
                            <input asp-for="IdUsuario" class="form-control" required />
                            <span asp-validation-for="IdUsuario" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="NombreCompleto" class="form-label"></label>
                            <input asp-for="NombreCompleto" class="form-control" required />
                            <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" type="email" required />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Clave" class="form-label"></label>
                            <input asp-for="Clave" class="form-control" type="password" required />
                            <span asp-validation-for="Clave" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="IdRol">Rol</label>
                            <select id="IdRol" name="IdRol" class="form-control" required>
                                <option value="" disabled selected>Seleccione un rol</option>
                                @foreach (var rol in Model.Roles)
                                {
                                    <option value="@rol.IdRol">@rol.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3 d-flex gap-2 align-items-center">
                            <img id="imagenPrevisualizacion" class="card-image" style="width:80px;height:80px;border-radius:50%;object-fit:cover;background:#f5f5f5;" />
                            <input id="Imagen" name="Imagen" type="file" accept="image/*" onchange="CargarImagen(event)" />
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="listar_Empleados" class="btn btn-outline-secondary">Volver</a>
                            <input type="submit" value="Agregar registro" class="btn btn-success ms-auto" id="btn-submit-usuario" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    @{
        int status = Convert.ToInt32(TempData["Status"]);

        Console.WriteLine("Estatus :",status);
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('form-usuario');
            var btnSubmit = document.getElementById('btn-submit-usuario');

            if (!form) return;

            // No usar attachFormSubmitPreventDouble aquí antes del submit diferido
            form.addEventListener('submit', function (e) {
                e.preventDefault(); // prevenimos el submit inmediato

                // mostrar modal/overlay profesional
                if (window.Swal) {
                    Swal.fire({
                        title: 'Procesando datos',
                        html: '<div style="display:flex;flex-direction:column;align-items:center;gap:10px;">' +
                              '<div class="spinner-border text-light" role="status" style="width:3rem;height:3rem"><span class="visually-hidden">Loading...</span></div>' +
                              '<div style="font-size:0.95rem;color:#e6e6e6">Por favor espere...</div>' +
                              '</div>',
                        background: '#141420',
                        color: '#fff',
                        showConfirmButton: false,
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        didOpen: function () {
                            try { Swal.showLoading(); } catch (err) { /* ignore */ }
                        }
                    });
                } else if (window.AppAlerts && typeof AppAlerts.showLoading === 'function') {
                    AppAlerts.showLoading('Procesando datos...');
                } else {
                    if (btnSubmit) {
                        btnSubmit.disabled = true;
                        if (btnSubmit.tagName.toLowerCase() === 'input') btnSubmit.value = 'Procesando...';
                        else btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Procesando...';
                    }
                }

                // pequeña pausa para que el usuario pueda ver la animación
                var delayMs = 900; // ajustar si quieres más/menos tiempo
                setTimeout(function () {
                    // prevenir doble envío a partir de ahora
                    if (window.AppAlerts && typeof AppAlerts.attachFormSubmitPreventDouble === 'function') {
                        AppAlerts.attachFormSubmitPreventDouble(form);
                    } else {
                        // fallback: desactivar botón permanentemente
                        if (btnSubmit) btnSubmit.disabled = true;
                    }

                    // realizar submit real
                    form.submit();
                }, delayMs);
            });
        });

        // preview imagen (preservado)
        var CargarImagen = function (event) {
            var result = document.getElementById("imagenPrevisualizacion");
            if (event.target.files && event.target.files[0]) {
                result.src = URL.createObjectURL(event.target.files[0]);
            } else {
                result.src = '';
            }
        }
    </script>
}