@model WebHotel_vesion1._0.Models.Usuario

@{ 
    ViewData["Title"] = "Eliminar Usuario"; 
}

<div class="container mt-5">
    <div class="card border-danger shadow-sm mx-auto" style="max-width:680px;">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Confirmar eliminación</h5>
        </div>

        <div class="card-body">
            @if (Model == null)
            {
                <div class="alert alert-warning">Usuario no encontrado.</div>
            }
            else
            {
                <p>Estás a punto de eliminar el usuario:</p>
                <ul>
                    <li><strong>ID:</strong> @Model.IdUsuario</li>
                    <li><strong>Nombre:</strong> @Model.NombreCompleto</li>
                    <li><strong>Correo:</strong> @Model.Correo</li>
                </ul>

                <form asp-controller="Usuarios" asp-action="DeleteUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />
                    <div class="d-flex gap-2">
                        <a asp-controller="Usuarios" asp-action="listar_Empleados" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>