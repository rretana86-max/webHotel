@* @model List<WebHotelvesion1.0.Models.Habitacion > *@
@model List<WebHotel_vesion1._0.Models.Habitacion>

@{
    ViewData["Title"] = "Reporte de Habitaciones";
}

<div class="container-fluid" style="padding: 20px 25px; margin-top: 25px;">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fas fa-bed mr-2"></i> Reporte de Habitaciones
            </h4>
            <a href="@Url.Action("ExportarPDF", "Habitaciones")" class="btn btn-danger">
                <i class="fas fa-file-pdf mr-2"></i> Exportar PDF
            </a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Precio por Noche</th>
                        <th>Disponibilidad</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td>@h.Numero</td>
                            <td>@h.Tipo</td>
                            <td>₡@h.PrecioPorNoche.ToString("N2")</td>
                            <td>
                                @if (h.EstaDisponible)
                                {
                                    <span class="badge badge-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">No Disponible</span>
                                }
                            </td>
                            <td>@h.Descripcion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>