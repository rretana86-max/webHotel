@model IEnumerable<WebHotel_vesion1._0.Models.Habitacion>

@{
    ViewData["Title"] = "listarHabitaciones";
}

    <div class="row justify-content-center" style="margin-top:5%">


        <div class="col-12 col-md-10" style="margin-left:1%">

        <a asp-controller="Habitaciones" asp-action="ReporteHabitaciones">
            <i class="fas fa-chart-bar"></i> Reporte de Habitaciones
            
        </a>

        <h2> <a class="btn btn-success " asp-action="Create">Agregar nuevo registro</a></h2>


           

            <div class="card card-secondary  shadow-lg border-0">

                <h3 class="card-header text-center ">Habitaciones registradas</h3>


                <div class="card-body">





                    <table class="table table-striped">
                        <thead>
                            <tr>

                                <th>
                                    @Html.DisplayNameFor(model => model.Numero)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Tipo)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.PrecioPorNoche)
                                </th>
                              
                                <th>
                                    @Html.DisplayNameFor(model => model.Descripcion)
                                </th>
                                 <th>

                                @Html.DisplayNameFor(model=>model.EstaDisponible)

                                 </th>

                                <th>
                                    Imagen
                                </th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.Numero)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Tipo)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PrecioPorNoche)
                                    </td>

                                    @*campo para  la descripcion*@


                                <td>
                                    @Html.DisplayFor(modelItem => item.Descripcion)
                                </td>
                                   
                                    <td>
                                    <input type="checkbox"
                                           class="availability-switch"
                                           data-id="@item.Id"
                                           @(item.EstaDisponible ? "checked" : "") />
                                </td>

                               
                                    
                                    <td>
                                        @* //<img src="@Url.Content("~/"+item.imageUrl)" alt="Imagen de la habitación" width="100" height="150" class="rounded-4" /> *@
                                        <img src="@Url.Content("~/"+item.imageUrl)?v=@DateTime.Now.Ticks" alt="Imagen de la habitación" width="100" height="100" class="rounded-4">

                                    </td>
                                <td class="d-flex gap-4 mt-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-lg bg-warning text-white"><i class="fa-solid fa-user-pen text-white"></i>Editar</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-lg bg-primary"><i class="fa-regular fa-eye"></i>Ver</a>

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-lg bg-danger"><i class="fa-solid fa-trash"></i>Eliminar</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>






                </div>

            </div>

        </div>

    </div>


<script>
      const switches = document.querySelectorAll(".availability-switch");// Gets the className. Remember: don't forget the dot (.)
       
    switches.forEach(function(switchElement){  // forEach iterates over each element with this class.

        switchElement.addEventListener("change",function(){

            
         const id = this.dataset.id;
         const estaDisponible = this.checked;

        ModifieldStatus(id,estaDisponible)

        });


        });

       function ModifieldStatus(id,estaDisponible){

    console.log(" ModifieldStatu")
          

      fetch(`/Habitaciones/UpdateStatus/`, {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ 
            id:id ,
            estaDisponible:estaDisponible })
    })
    .then(response => response.json())
    .then(data => {
        console.log("Success:", data);
    })
    .catch((error) => {
        console.error("Error:", error);
    });
    }


</script>


<style>

    .card {
        overflow-y: hidden;
        min-width: 100%
    }

    body {
        background: purple
    }

    /* ajustar texto e imagines en las celdas de la tabla  */
    td {
        margin-left: 2px
    }

</style>


                                        
                       
                                            

                                        