<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@* <!-- jQuery UI -->
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
@* <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script> *@
<script src="https://js.stripe.com/v3/"></script>
@using System.Security.Claims

    @model WebHotel_vesion1._0.Models.Habitacion;

@{

    // string cedula = User.FindFirstValue("IdUsuario");

}


<div class="row justify-content-center p-2  mb-4">
    <div class="col-12">
        <div class="card shadow-lg">
            <div class="card-body">

                <!-- Fila para Check-in y Check-out -->
                <div class="row">

                    <div class="col-12 col-md-6 col-fecha">
                        <p class="text-center text-uppercase">
                            <label for="FechaInicio" class="text-success">Check-in</label>
                        </p>
                        <input type="date" id="FechaInicio" name="FechaInicio"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               required class="form-control " />
                    </div>

                    <div class="col-12 col-md-6 col-fecha">
                        <p class="text-center text-uppercase">
                            <label for="FechaFin" class="text-success">Check-out</label>
                        </p>
                        <input type="date" id="FechaFin" name="FechaFin"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               required class="form-control "/>
                    </div>
                    <h4 class="pt-2  mb-2 text-success"><span id="totalPagar" style="cursor:pointer; border-bottom:2px solid gray">Total a pagar:$ </span></h4>
                </div>
                <!-- fin fila -->

            </div>
        </div>
    </div>
</div>








    <div class="row justyfy-content-center">

        <div class="col-12"> 

            <div class=" card shadow-lg border-0">

                <h2 class="card-header  bg-gray text-center">Detalle habitacion</h2>
                <div class="card-body">


                    <div class="row justify-content-center mb-1">

                        <div class="col-md-6 pt-3   h-25 shadow-lg border-0">
                            <p>
                                @Model.Descripcion<br />
                            </p>
                            <p>
                            
                        <p>   Precio por noche:   @Model.PrecioPorNoche</p>
                            <input type="hidden" id="PrecioPorNoche" value="@Model.PrecioPorNoche" />
                            </p>

                        <button type="button" id="btnPagar"class="btn btn-warning mb-2"data-bs-toggle="modal" data-bs-target="#cardModal"style="display:none">Pagar</button>


                        <div class="row mt-2 border-0 mb-0">


                            <form asp-action="EfectuarReservacion" asp-controller="Reservas" method="post" id="form-Reserva">

                                <div class="row justify-content-center">
                                    <div class="col-md-6">

                                        <div class="form-group">

                                            <input type="hidden" value="@Model.Id" name="Id">
                                        </div>
    
                                    </div>
                                    @* campos de las fechas *@
                                    <div class="form-group">

                                        <input type="date" id="ckeck_in" name="ckeck_in" hidden />

                                    </div>
                                    <div class="form-group">

                                        <input type="date" id="ckeck_out" name="ckeck_out" hidden />

                                    </div>

                                    </div>

                               
                            </form>

                        </div>
                            

                        </div>
                        <div class="col-md-6 p-2">

                            <div class="card shadow-lg border-0">
                                <div class="card-body">

                                <img src="@Url.Content("~/"+Model.imageUrl)" class="w-100 card-img-top" style="border-radius:2%" />
                                <h4 class="card-title">habitacion matrimonial</h4>

                                <p class="card-text">habitacion  hermosa de gran espacio y relax</p>


                                </div>
                            

                            </div>

                          
                        </div>
                    </div>

                  


                    @if (ViewBag.Mensaje != null)

                    {
                        <script>


                            Swal.fire({
                                title: "@ViewBag.Mensaje.Value"
                                ,
                                icon: "success"



                            });



                        </script>



                    }
                </div>







                @* inputs para las fechas *@





            </div>


        </div>










    </div>

<!-- Modal simple -->
<!-- Modal Bootstrap -->



<div class="modal fade" id="cardModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Pago con tarjeta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label">Nombre del titular</label>
                    <input type="text" id="cardHolder" class="form-control" placeholder="Nombre como aparece en la tarjeta">
                </div>

                <div class="mb-3">
                    <label class="form-label">Datos de la tarjeta</label>
                    <div id="card-element" class="form-control p-3"></div>
                </div>

                <div id="card-errors" class="text-danger small"></div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="confirmarPago">Pagar</button>
            </div>

        </div>
    </div>
</div>


<style>

    body {
        background-color: white
    }

    p {
        cursor: pointer;
        font-weight: 600;
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif
    }

    .contenedor-fechas {
        background-color: whitesmoke;
        padding: 2%;
        cursor: pointer
    }
    /* personalizacion de los colores para dia mes y anio */

    input[type=date]::-webkit-datetime-edit-month-field {
        color: red;
    }

    input[type=date]::-webkit-datetime-edit-day-field {
        color: green;
    }

    input[type=date]::-webkit-datetime-edit-year-field {
        color: blue;
    }


</style>
<script>

    document.addEventListener("DOMContentLoaded", function () {

        console.log("DOM cargado correctamente");


        const valorInputFechaIni = document.getElementById("FechaInicio");
        const valorInputFechaFin = document.getElementById("FechaFin");
        const btnPagar = document.getElementById("btnPagar");
        const formReserva = document.getElementById("form-Reserva");
        const confirmarpago=document.getElementById("confirmarPago");

        confirmarpago.addEventListener("click",EnviarDatos);

        function calcularTotal() {

            
           

            const fechaInicial = new Date(valorInputFechaIni.value);
            const fechaFinal = new Date(valorInputFechaFin.value);

            if (valorInputFechaIni.value && valorInputFechaFin.value && fechaFinal > fechaInicial) {

                const precioPorNoche = parseFloat(document.getElementById("PrecioPorNoche").value);
                const dias = (fechaFinal - fechaInicial) / (1000 * 60 * 60 * 24);
                const precioTotal = precioPorNoche * dias;

                document.getElementById("totalPagar").innerHTML =
                    "Total a pagar: $ " + precioTotal;

                btnPagar.style.display = "block";
            }
            else {
                btnPagar.style.display = "none";
            }
        }

        valorInputFechaIni.addEventListener("input", calcularTotal);
        valorInputFechaFin.addEventListener("input", calcularTotal);


      formReserva.addEventListener("submit", function (e) {

            if (!valorInputFechaIni.value || !valorInputFechaFin.value) {

                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: "Debe seleccionar las fechas"
                });

                e.preventDefault();
                return;
            }

            const inputFechaInicio = new Date(valorInputFechaIni.value);
            const inputFechaFinal = new Date(valorInputFechaFin.value);

            if (inputFechaInicio >= inputFechaFinal) {

                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: "Rango de fechas inválido"
                });

                e.preventDefault();
                return;
            }


            

            document.getElementById("ckeck_in").value = valorInputFechaIni.value;
            document.getElementById("ckeck_out").value = valorInputFechaFin.value;
        });





    //logica para el manejo de stripePublicKey
    const stripe = Stripe("@ViewBag.StripePublicKey");

    const elements = stripe.elements();

    const card = elements.create("card", {
        style: {
            base: {
                fontSize: "16px",
                color: "#32325d"
            }
        }
    });

    card.mount("#card-element");

   async function EnviarDatos() {
        console.log("public key",stripe);

        const cardHolder = document.getElementById("cardHolder").value.trim();
        
          

        const { paymentMethod, error } = await stripe.createPaymentMethod({
            type: "card",
            card: card,
            billing_details: {
                name: cardHolder
            }
        });

        if (error) {
            document.getElementById("card-errors").textContent = error.message;
            return;
        }

        fetch("/Pagos/ProcesarPago", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                paymentMethodId: paymentMethod.id,
                reservaId: 1
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Pago exitoso");
                location.reload();
            } else {
                alert("Error procesando pago");
            }
        });
    }

    });




</script>

