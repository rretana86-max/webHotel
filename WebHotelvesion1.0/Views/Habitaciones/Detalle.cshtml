<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@* <!-- jQuery UI -->
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
@* <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script> *@
@using System.Security.Claims 

    @model WebHotel_vesion1._0.Models.Habitacion;
 
@{
 
        // string cedula = User.FindFirstValue("IdUsuario");

}


    <div class="row">

        <div class="col col-md-10">
            <div class="row row-no-gutters justify-content-center mt-4  contenedor-fechas">


                <div class="col col-md-6 col-fecha">
                <p class="text-center text-uppercase"><label for="FechaInicio" class="text-success ">Ckeck-in</label></p>

                <input type="date" id="FechaInicio" name="FechaInicio" required />


                </div>
                <div class=" col col-md-6 col-fecha">
                <p class="text-center text-uppercase"><label for="FechaFin" class="text-danger text-md-center">Check-out</label></p>

                <input type="date" id="FechaFin" name="FechaFin" required />


                </div>




            </div>
        </div>

        </div>
    
   




<div class="container container-fluid">

    <div class="row justify-content-center mt-5">

<div class="col col-md-8">

    <div class=" card  shadow-lg border-0  bg-secondary">

        <h2 class="card-header bg-black text-center">Detalle habitacion</h2>
        <div class="card-body">
                  





            </div>

            <div class="row justify-content-center">
                
                <div class="col col-md-5">



                            <label><strong>Id : </strong>@Model.Id</label>
                </div>

                        <div class="col col-md-5">
                            <label><strong>Descripcion:</strong> @Model.Descripcion</label>
                        </div>
            </div>


            <div class="row justify-content-center">

                <div class="col-md-8">



                    <img  src="@Url.Content("~/"+Model.imageUrl)" class="w-100"/>
                </div>
                    </div>
                

            <div class="row mt-2 border-0 mb-0">


                        <form asp-action="EfectuarReservacion" asp-controller="Reservas" method="post" id="form-Reserva">

                            <div class="row justify-content-center">
                                <div class="col-md-6">

                                    <div class="form-group">

                                      <input type="hidden" value="@Model.Id" name="Id">
                                    </div>


                                    
                                
                                </div>
                                @* campos de las fechas *@
                               <div class="form-group">

                                <input type="date" id="ckeck_in" name="ckeck_in" hidden/>

                               </div>
                               <div class="form-group">

                                <input type="date" id="ckeck_out" name="ckeck_out" hidden />

                               </div>
                            <div class="form-group">

                               

                            </div>

                                <div class="row justify-content-center mt-2 mb-2">

                                    <div class="col col-md-6">
                                        <input type="submit" value="Reservar" class="btn  btn-primary w-100 text-white rounded 3"/>



                                    </div>


                                </div>



                            </div>



                            



                        </form>

            </div>
                          
                   
            @* inputs para las fechas *@


           


        </div>


    </div>



       
    





</div>



<style>

    body{background-color:darkslategray}
   

    .contenedor-fechas{

      
        background-color:black;
      
      
        margin-left:15%
    
    }


            input[type=date] {
                height: 55px;
                margin: 0 auto;
                width: 100%;
                font-family: arial, sans-serif;
                font-size: 18px;
                font-weight: bold;
                text-transform: uppercase;
                background-color: lighten(#2f2f2f,40%);
                outline: none;
                border: 0;
                border-radius: 3px;
                padding-bottom: 4px;
                color: #fff;
                &::-webkit-datetime-edit-month-field

            {
                color: red;
            }

            &::-webkit-datetime-edit-day-field {
                color: green;
            }

            &::-webkit-datetime-edit-year-field {
                color: blue;
            }


</style>

<script>
    const formReserva = document.getElementById("form-Reserva");

    formReserva, addEventListener('submit', function (e) {

        const inputFechaInicio = new Date(document.getElementById("FechaInicio").value);

        const inputFechaFinal = new Date(document.getElementById("FechaFin").value);

        // cargamos las fechas en los inputs para enviarlas al controlador
        alert(inputFechaFinal);
        document.getElementById("ckeck_in").value = document.getElementById("FechaInicio").value;
        document.getElementById("ckeck_out").value = document.getElementById("FechaFin").value;
        
        if (inputFechaInicio>inputFechaFinal) {
            alert("Invalidate dates retry againt")
        
            e.preventDefault();
          
        
        }
       

    
    });

    

</script>
