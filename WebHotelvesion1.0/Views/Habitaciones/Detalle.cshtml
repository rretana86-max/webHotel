@model WebHotel_vesion1._0.Models.Habitacion

@{
    ViewData["Title"] = "Detalle de Habitación";
}

<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm overflow-hidden">
                <div class="row g-0">
                    <!-- IMAGEN -->
                    <aside class="col-12 col-md-6 bg-light d-flex align-items-center justify-content-center p-3">
                        <img src="@Url.Content("~/" + Model.imageUrl)" alt="Imagen @Model.Tipo" class="img-fluid rounded" style="max-height:420px; object-fit:cover; width:100%;"/>
                    </aside>

                    <!-- CONTENIDO -->
                    <section class="col-12 col-md-6 p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h1 class="h4 fw-bold mb-1">@Model.Tipo</h1>
                                <p class="text-muted mb-0 small"><i class="fa-solid fa-hashtag me-1"></i>ID: @Model.Id</p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success px-3 py-2">Disponible</span>
                            </div>
                        </div>

                        <p class="mb-3 text-secondary" style="line-height:1.45;">
                            @Model.Descripcion
                        </p>

                        <div class="mb-3 d-flex align-items-center gap-3">
                            <div class="fs-5 fw-semibold text-primary">₡ @Model.PrecioPorNoche.ToString("N2") <small class="text-muted">por noche</small></div>
                            <div class="text-muted small"><i class="fa-regular fa-calendar me-1"></i>Máx personas: 2</div>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label class="form-label small text-muted"><i class="fa-regular fa-calendar-days me-1"></i> Fechas</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input id="FechaInicio" name="FechaInicio" class="form-control form-control-lg" placeholder="Check-in" />
                                </div>
                                <div class="col-6">
                                    <input id="FechaFin" name="FechaFin" class="form-control form-control-lg" placeholder="Check-out" />
                                </div>
                            </div>
                            <div class="mt-2 small text-muted">Selecciona rango válido. Tarifas sujetas a disponibilidad.</div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-3">
                            <div>
                                <div class="small text-muted">Total estimado</div>
                                <div id="totalPagar" class="h5 fw-bold">₡ 0.00</div>
                            </div>

                            <div class="d-flex flex-column">
                                <button id="btnReservar" class="btn btn-primary btn-lg mb-2" type="button" disabled>
                                    <i class="fa-solid fa-bed me-2"></i>Reservar ahora
                                </button>
                                <button id="btnPagar" class="btn btn-outline-warning btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#cardModal" style="display:none">
                                    <i class="fa-solid fa-credit-card me-2"></i>Pagar
                                </button>
                            </div>
                        </div>

                        <form asp-action="EfectuarReservacion" asp-controller="Reservas" method="post" id="form-Reserva" class="d-none">
                            <input type="hidden" name="Id" value="@Model.Id" />
                            <input type="hidden" id="ckeck_in" name="ckeck_in" />
                            <input type="hidden" id="ckeck_out" name="ckeck_out" />
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tarjeta (se mantiene similar) -->
<div class="modal fade" id="cardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Pago con tarjeta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="cardHolder" class="form-label">Nombre del titular</label>
                    <input type="text" id="cardHolder" class="form-control" placeholder="Nombre como aparece en la tarjeta" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Datos de la tarjeta</label>
                    <div id="card-element" class="form-control p-3"></div>
                </div>
                <div id="card-errors" class="text-danger small"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmarPago" class="btn btn-primary">Pagar</button>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --accent: #0d6efd;
        --muted: #6b7280;
        --card-radius: 10px;
        --bg-1: #e9f2ff;
        --bg-2: #f7fbff;
    }

    /* Fondo nuevo: degradado suave + textura sutil mediante repeating-linear-gradient */
    body {
        background-color: var(--bg-2);
        background-image:
            linear-gradient(180deg, rgba(13,110,253,0.03), rgba(102,16,242,0.02)),
            repeating-linear-gradient(45deg, rgba(255,255,255,0.04) 0 10px, transparent 10px 20px);
        background-attachment: fixed;
        min-height: 100vh;
    }

    /* Elevar la tarjeta sobre el fondo, aumentar contraste y profesionalismo */
    .card {
        border-radius: var(--card-radius);
        background: rgba(255,255,255,0.98);
        box-shadow: 0 12px 30px rgba(6, 30, 80, 0.12);
    }

    /* Calendars and inputs */
    .flatpickr-calendar { z-index: 20000; }

    /* Mejor legibilidad del precio */
    #totalPagar { color: var(--accent); }

    /* Responsive tweaks (escapar @@media para Razor: @@media) */
    @@media (max-width: 767.98px) {
        .card { margin: 0 1rem; }
    }

    /* Preferencias de usuario: reducir animaciones si es necesario */
   @@media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
    }
</style>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>

    <script>
        (() => {
            const precio = parseFloat('@Model.PrecioPorNoche'.replace(',', '.')) || 0;
            const fpOptions = {
                dateFormat: "Y-m-d",
                minDate: "today",
                onChange: calculateTotal
            };

            // Initialize flatpickr
            flatpickr("#FechaInicio", Object.assign({}, fpOptions));
            flatpickr("#FechaFin", Object.assign({}, fpOptions));

            const inputInicio = document.getElementById("FechaInicio");
            const inputFin = document.getElementById("FechaFin");
            const totalEl = document.getElementById("totalPagar");
            const btnPagar = document.getElementById("btnPagar");
            const btnReservar = document.getElementById("btnReservar");
            const formReserva = document.getElementById("form-Reserva");

            function formatCurrency(value) {
                return new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 2 }).format(value).replace('CRC', '₡');
            }

            function calculateTotal(selectedDates, dateStr, instance) {
                const start = inputInicio.value ? new Date(inputInicio.value) : null;
                const end = inputFin.value ? new Date(inputFin.value) : null;

                if (!start || !end || end <= start) {
                    totalEl.innerText = formatCurrency(0);
                    btnPagar.style.display = 'none';
                    btnReservar.disabled = true;
                    return;
                }

                const days = Math.round((end - start) / (1000 * 60 * 60 * 24));
                const total = precio * days;
                totalEl.innerText = formatCurrency(total);
                btnPagar.style.display = 'inline-block';
                btnReservar.disabled = false;

                // populate hidden form for non-AJAX submit
                document.getElementById('ckeck_in').value = inputInicio.value;
                document.getElementById('ckeck_out').value = inputFin.value;
            }

            // Reserva rápida: muestra processing y envía el form oculto (post)
            btnReservar.addEventListener('click', function () {
                if (window.Swal) {
                    Swal.fire({
                        title: 'Procesando reserva',
                        html: '<div class="d-flex flex-column align-items-center gap-2"><div class="spinner-border text-light" role="status" style="width:3rem;height:3rem"></div><div class="text-muted">Espere por favor...</div></div>',
                        showConfirmButton: false,
                        allowOutsideClick: false,
                        background: '#141420',
                        color: '#fff',
                        didOpen: () => { try { Swal.showLoading(); } catch (e) {} }
                    });
                } else if (window.AppAlerts) {
                    AppAlerts.showLoading('Procesando reserva...');
                }

                // submit formReserva after tiny delay so modal is visible
                setTimeout(() => {
                    formReserva.submit();
                }, 600);
            });

            // Stripe payment: keep existing flow but show polished errors/success
            const stripeKey = "@ViewBag.StripePublicKey";
            if (stripeKey && document.getElementById('card-element')) {
                const stripe = Stripe(stripeKey);
                const elements = stripe.elements();
                const card = elements.create("card", {
                    style: { base: { fontSize: "16px", color: "#32325d" } }
                });
                card.mount("#card-element");

                document.getElementById('confirmarPago').addEventListener('click', async () => {
                    const holder = document.getElementById('cardHolder').value.trim();
                    if (!holder) {
                        Swal.fire('Falta dato', 'Ingrese el nombre del titular.', 'warning');
                        return;
                    }

                    const { paymentMethod, error } = await stripe.createPaymentMethod({
                        type: "card",
                        card,
                        billing_details: { name: holder }
                    });

                    if (error) {
                        Swal.fire('Error de tarjeta', error.message, 'error');
                        return;
                    }

                    // call server endpoint
                    try {
                        if (window.AppAlerts) AppAlerts.showLoading('Procesando pago...');
                        const resp = await fetch("/Pagos/ProcesarPago", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ paymentMethodId: paymentMethod.id, reservaId: 1 })
                        });
                        const data = await resp.json();
                        if (data.success) {
                            Swal.fire('Pago exitoso', 'Gracias por su compra.', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', data.message || 'No se pudo procesar el pago.', 'error');
                        }
                    } catch (ex) {
                        Swal.fire('Error', 'Falla en la comunicación con el servidor.', 'error');
                    } finally {
                        if (window.AppAlerts) AppAlerts.hideLoading();
                    }
                });
            }

        })();
    </script>
}

