@model WebHotel_vesion1._0.ViewModels.ReservaVM

@{
    ViewData["Title"] = "Confirmación de reservación";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="row g-0">
                    <aside class="col-12 col-sm-4 bg-gradient p-4 d-flex flex-column justify-content-center align-items-center text-white">
                        <i class="fa-solid fa-check-circle fa-4x mb-3"></i>
                        <h5 class="mb-0">Reserva confirmada</h5>
                        <small class="opacity-75">Código <strong class="d-block mt-2">@Model?.Id</strong></small>
                    </aside>

                    <section class="col-12 col-sm-8 p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h4 class="mb-1">@Model?.NombreHabitacion</h4>
                                <p class="text-muted mb-0">Reservado por: <strong>@Model?.NombreUsuario</strong></p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success">Confirmada</span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-6">
                                <div class="mb-2 text-muted small">Check-in</div>
                                <div class="fw-medium">@Model?.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="col-6">
                                <div class="mb-2 text-muted small">Check-out</div>
                                <div class="fw-medium">@Model?.FechaSalida.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="text-muted small">Total a pagar</div>
                                <div class="h5 mb-0 text-primary">₡ @Model?.Total.ToString("N2")</div>
                            </div>
                            <div class="text-end">
                                <button id="btn-print-inline" class="btn btn-outline-primary me-2">
                                    <i class="fa-solid fa-print me-1"></i> Imprimir recibo
                                </button>
                                <a asp-controller="Reservas" asp-action="MisReservas" class="btn btn-primary">
                                    <i class="fa-regular fa-list me-1"></i> Ver mis reservas
                                </a>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded">
                            <small class="text-muted">Notas</small>
                            <p class="mb-0 small">
                                Presenta este recibo en el front desk. Para cambios o cancelaciones revisa la política de la reserva.
                            </p>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        (function () {

            const reserva = {
                id: @Model.Id,
                nombreUsuario: "@Model.NombreUsuario",
                nombreHabitacion: "@Model.NombreHabitacion",
                fechaIngreso: "@Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")",
                fechaSalida: "@Model.FechaSalida.ToString("dd/MM/yyyy HH:mm")",
                total: @Model.Total
            };

            function formatCurrency(value) {
                try {
                    return new Intl.NumberFormat('es-CR', {
                        style: 'currency',
                        currency: 'CRC',
                        maximumFractionDigits: 2
                    }).format(Number(value)).replace('CRC', '₡');
                } catch (e) {
                    return '₡ ' + Number(value || 0).toFixed(2);
                }
            }

            function buildReceiptHtml(r) {
                return `
                    <div style="font-family:system-ui, Arial, sans-serif; color:#222; text-align:left;">
                        <h3 style="margin:0 0 8px 0;">Recibo</h3>
                        <p style="margin:0 0 12px 0; color:#555;">
                            Código: <strong>${r.id}</strong>
                        </p>
                        <table style="width:100%;font-size:14px;border-collapse:collapse;">
                            <tr><td style="padding:6px 0;color:#666;width:40%">Nombre</td><td>${r.nombreUsuario}</td></tr>
                            <tr><td style="padding:6px 0;color:#666">Habitación</td><td>${r.nombreHabitacion}</td></tr>
                            <tr><td style="padding:6px 0;color:#666">Check-in</td><td>${r.fechaIngreso}</td></tr>
                            <tr><td style="padding:6px 0;color:#666">Check-out</td><td>${r.fechaSalida}</td></tr>
                            <tr><td style="padding:6px 0;color:#666">Total</td><td>${formatCurrency(r.total)}</td></tr>
                        </table>
                        <p style="margin-top:12px;font-size:12px;color:#666">
                            Gracias por confiar en nosotros.
                        </p>
                    </div>`;
            }

            function printHtml(html) {
                const w = window.open('', '_blank');
                if (!w) {
                    alert('Permite popups para imprimir.');
                    return;
                }

                w.document.write(`
                    <html>
                        <head>
                            <meta charset="utf-8">
                            <title>Recibo</title>
                        </head>
                        <body style="font-family:Arial;padding:20px;">
                            ${html}
                        </body>
                    </html>
                `);

                w.document.close();

                setTimeout(() => {
                    w.print();
                    w.close();
                }, 300);
            }

            document.addEventListener('DOMContentLoaded', function () {

                const html = buildReceiptHtml(reserva);

                if (window.Swal) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Reserva exitosa!',
                        html: html,
                        showDenyButton: true,
                        confirmButtonText: 'Ver mis reservas',
                        denyButtonText: 'Imprimir recibo',
                        width: 720,
                        allowOutsideClick: false
                    }).then(result => {
                        if (result.isConfirmed) {
                            location.href = '@Url.Action("MisReservas", "Reservas")';
                        } else if (result.isDenied) {
                            printHtml(html);
                        }
                    });
                }

                const btnPrint = document.getElementById('btn-print-inline');
                if (btnPrint) {
                    btnPrint.addEventListener('click', () => {
                        printHtml(buildReceiptHtml(reserva));
                    });
                }

            });

        })();
    </script>
}